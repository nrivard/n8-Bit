
(rules PCB n8 bit special
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (app.freerouting.autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 8)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule "GND_PLANE"
      (active off)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule "PWR_PLANE"
      (active off)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
  )
  (rule
    (width 154.0)
    (clear 200.2)
    (clear 77.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd_smd))
  )
  (padstack "Via[0-3]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle "GND_PLANE" 800.0 0.0 0.0)
    )
    (shape
      (circle "PWR_PLANE" 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_800:400_um" "Via[0-3]_800:400_um" default
  )
  (via 
    "Via[0-3]_800:400_um-kicad_default" "Via[0-3]_800:400_um" "kicad_default"
  )
  (via 
    "Via[0-3]_800:400_um-Power" "Via[0-3]_800:400_um" Power
  )
  (via_rule
    default "Via[0-3]_800:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-3]_800:400_um-kicad_default"
  )
  (via_rule
    Power "Via[0-3]_800:400_um-Power"
  )
  (class default
    "Net-(D1-Pad1)" ~{RES} "USB_D+" "USB_D-" /A0 /D0 /A1 /D1
    /A2 /D2 /A3 /D3 /A4 /D4 /A5 /D5
    "~{PORT0_CS}" /D6 R~{W} /D7 CLK "PORT0_IRQ_PULLUP" "PORT0_NMI_PULLUP" FUTURE0
    FUTURE1 "~{PORT2_CS}" "PORT2_IRQ_PULLUP" "PORT2_NMI_PULLUP" "PORT1_NMI_PULLUP" "PORT1_IRQ_PULLUP" "~{PORT1_CS}" "Net-(RN1-Pad3)"
    "Net-(J6-Pad4)" "Net-(J6-Pad6)" "Net-(J6-Pad8)" "Net-(J6-Pad10)" "Net-(J6-Pad12)" /A12 /A13 ~{IRQ}
    /A14 /A15 ~{NMI} /A6 /A7 /A8 /A9 /A10
    "Net-(C10-Pad1)" /A11 "~{RAM2_CS}" "~{RAM1_CS}" "~{ROM_CS}" "unconnected-(J1-Pad6)" "unconnected-(J1-Pad4)" "unconnected-(U1-Pad39)"
    "Net-(D1-Pad2)" "Net-(Q1-Pad2)" ~{READ} ~{WRITE} "unconnected-(U1-Pad12)" "unconnected-(U1-Pad8)" "unconnected-(U1-Pad6)" "unconnected-(U1-Pad4)"
    "unconnected-(U1-Pad2)" "unconnected-(U1-Pad43)" "Net-(D2-Pad1)" "Net-(D3-Pad1)" "unconnected-(U6-Pad16)" RxD TxD ~{RTS}
    "unconnected-(U8-Pad15)" "unconnected-(U8-Pad13)" "unconnected-(U8-Pad11)" ~{CTS} "~{UART_IRQ}" "RDY_PULLUP" "BE_PULLUP" "~{UART_CS}"
    "UART_RES" "Net-(U10-Pad1)" "unconnected-(X1-Pad1)" "unconnected-(U5-Pad15)" "unconnected-(U5-Pad13)" "unconnected-(U5-Pad11)" "unconnected-(U5-Pad1)" "unconnected-(U5-Pad3)"
    "unconnected-(U5-Pad5)" "unconnected-(U5-Pad43)" "unconnected-(U5-Pad41)" "unconnected-(U5-Pad42)" "unconnected-(U5-Pad14)" "unconnected-(U5-Pad16)" "unconnected-(U5-Pad17)" "unconnected-(U5-Pad23)"
    "unconnected-(U5-Pad29)" "unconnected-(U5-Pad30)" "unconnected-(U5-Pad34)" "unconnected-(U5-Pad40)" "unconnected-(U5-Pad31)" "unconnected-(U5-Pad37)" "unconnected-(U8-Pad7)" "unconnected-(U8-Pad8)"
    "unconnected-(U8-Pad10)" "unconnected-(U8-Pad12)" "Net-(D2-Pad2)" "Net-(D3-Pad2)" "Net-(Q2-Pad2)" "Net-(Q3-Pad2)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 154.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 154.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power
    GND +5V
    (clearance_class Power)
    (via_rule Power)
    (rule
      (width 300.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)